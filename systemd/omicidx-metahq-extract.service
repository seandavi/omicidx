# MetaHQ new-release check + extract (#266), following
# omicidx-ncbi-taxonomy-extract.service. Convention: monode/infrastructure's
# SCHEDULING.md.
#
# Each run asks Zenodo for MetaHQ's newest version; a version already landed is a
# no-op (one API call). A new one lands whole on R2 under metahq/raw/<version>/,
# and the next omicidx-downstream run loads and publishes it.
#
# No Conflicts= and no flock: one ~55 MB HTTPS download at most.
[Unit]
Description=Check Zenodo for a new MetaHQ release and land it on R2
Documentation=https://github.com/seandavi/omicidx/issues/266
After=network-online.target
Wants=network-online.target
OnFailure=ntfy-notify@%N.service

[Service]
Type=oneshot
WorkingDirectory=/home/davsean/Documents/git/omicidx
EnvironmentFile=/home/davsean/Documents/git/omicidx/.env
# NOT `/usr/bin/env uv` — systemd --user's minimal PATH excludes ~/.local/bin
# (#153).
ExecStart=%h/.local/bin/uv run python -m omicidx.prefect.flows.metahq run
# RuntimeMaxSec= silently has no effect on Type=oneshot — use TimeoutStartSec=.
TimeoutStartSec=1800
Nice=10

[Install]
WantedBy=default.target
