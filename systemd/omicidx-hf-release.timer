[Unit]
Description=Monthly omicidx HuggingFace release
Documentation=https://github.com/seandavi/omicidx/issues/204

[Timer]
# The 2nd at 12:00 UTC: well after the 05:00 downstream run, so the 2nd's
# folder is normally complete and becomes that month's release. The flow takes
# the newest folder that has a manifest.json; if that is still last month's,
# its tag already exists and the run is a no-op, so release by hand with
# `omicidx-prefect run hf-release --date YYYY-MM-DD`.
OnCalendar=*-*-02 12:00:00 UTC
RandomizedDelaySec=900
Persistent=true

[Install]
WantedBy=timers.target
