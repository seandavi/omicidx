[Unit]
Description=Daily omicidx downstream pipeline (lake load -> transform -> export -> postgres -> publish)
Documentation=https://github.com/seandavi/omicidx/issues/158

[Timer]
# 05:00 UTC: after the last extract slot (biosample 04:00 +<=30m jitter). The
# chain reads whatever raw the extract timers have landed; it does not wait on
# them, so an extract that overruns lands in the next day's load instead of
# blocking this one. That decoupling is the point of #149 — a wedged extract
# can no longer hold the publish hostage, which is exactly what GEO did for a
# month (#174).
OnCalendar=*-*-* 05:00:00 UTC
RandomizedDelaySec=900
Persistent=true

[Install]
WantedBy=timers.target
