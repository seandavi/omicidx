[Unit]
Description=Weekly omicidx DuckLake catalog maintenance
Documentation=https://github.com/seandavi/omicidx/issues/158

[Timer]
# Weekly, the cadence the retired Prefect deployment had (`0 4 * * 0`) — but
# Sunday 09:00 UTC. The daily chain starts at 09:00 America/Denver (15:00-16:00
# UTC), and maintenance takes minutes, so 09:00 finishes well before it:
# compaction rewriting the same data files a load is merging into is a
# transaction conflict waiting to happen. Under Prefect both ran in the same
# window and got away with it; this just stops relying on that.
OnCalendar=Sun *-*-* 09:00:00 UTC
RandomizedDelaySec=1800
Persistent=true

[Install]
WantedBy=timers.target
