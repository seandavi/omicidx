!Sample_title = HRPE1_SAGE
!Sample_geo_accession = GSM571
!Sample_status = Public on Oct 03 2001
!Sample_submission_date = Sep 19 2001
!Sample_last_update_date = Nov 19 2008
!Sample_type = SAGE
!Sample_anchor = NlaIII
!Sample_tag_length = 10
!Sample_tag_count = 53666
!Sample_channel_count = 1
!Sample_source_name_ch1 = human retinal pigment epithelium (RPE)
!Sample_organism_ch1 = Homo sapiens
!Sample_taxid_ch1 = 9606
!Sample_molecule_ch1 = total RNA
!Sample_description = Profile of the genes expressed in the human peripheral retina, macula, and retinal pigment epithelium determined through serial analysis of gene expression (SAGE).
!Sample_description = 
!Sample_description = A normal retinal pigment epithelium (RPE) from an 88-year-old female.
!Sample_description = Patient had periocular malignancies that required exenteration of a normal eye as part of the clinically indicated surgical therapy.  The eye was placed in saline after it was removed from the patient and the RPE from the posterior pole and the periphery was harvested by gentle scraping with a Pasteur pipette. Fragments of RPE were collected by aspiration in sterile 0.9% saline.  Tissue fragments were collected and frozen within 45 minutes of the surgical removal to ensure  minimal degradation of mRNA molecules. The RPE fragments were from the posterior pole and the periphery.
!Sample_platform_id = GPL4
!Sample_contact_name = Dror,,Sharon
!Sample_contact_email = dror_sharon@meei.harvard.edu
!Sample_contact_phone = 617-573-4347
